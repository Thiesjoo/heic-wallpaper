# --- S3 Upload configuration (MinIO) ---
UPLOAD_S3_URL="http://localhost:9000"
UPLOAD_S3_BUCKET="uploads"
UPLOAD_S3_ACCESS_KEY="minioadmin"
UPLOAD_S3_SECRET_KEY="minioadmin"
UPLOAD_S3_REGION="eu-central-003"

# --- S3 Result configuration (MinIO) ---
RESULT_S3_URL="http://localhost:9000"
RESULT_S3_BUCKET="results"
RESULT_S3_ACCESS_KEY="minioadmin"
RESULT_S3_SECRET_KEY="minioadmin"
RESULT_S3_REGION="eu-central-003"

# --- Django Server URLs ---
# The public base URL of your Django API (running locally)
PUBLIC_URL="http://localhost:8000"
# The public base URL where raw S3 asset results are served from
PUBLIC_ASSET_URL="http://localhost:9000/results"

# --- OIDC Configuration (e.g. Authentik, Keycloak, etc.) ---
# You can also use AUTHENTIK_API_URL and AUTHENTIK_CLIENT_ID for backward compatibility
OIDC_ISSUER="https://authentik.thies.dev/application/o/wallpaper-dev/"
OIDC_AUDIENCE="wallpaper-dev"

# --- Database configuration (PostgreSQL) ---
DB_NAME="heicwallpaper"
DB_USER="heicwallpaper"
DB_PASSWORD="heicwallpaper"
DB_HOST="localhost"
DB_PORT="5435"

# --- Celery / Redis Broker URL ---
BROKER_URL="redis://localhost:6379/0"

# --- Django application settings ---
DEV="true"
SECRET_KEY="django-insecure-development-secret-key-change-me"
